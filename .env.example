# AI provider configuration
# Local development uses Ollama by default.
# Deployments (Railway, Render, Fly) should use Groq.

# Which AI provider to use: "ollama" or "groq"
AI_PROVIDER=ollama

# Ollama (local development)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Groq (cloud deployment) — get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

