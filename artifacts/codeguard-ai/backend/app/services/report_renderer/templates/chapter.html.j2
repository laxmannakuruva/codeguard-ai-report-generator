{% for ch in ctx.chapters %}
<section class="page chapter" id="anchor-chapter-{{ loop.index }}">
  <h1 class="chapter-title">{{ ch.heading }}</h1>

  {% if ch.blocks %}
    {% for block in ch.blocks %}
      {% if block.type == "h2" %}
        <h2 class="subheading">{{ block.text }}</h2>
      {% elif block.type == "p" %}
        <p>{{ block.text }}</p>
      {% elif block.type == "ol" %}
        <ol>{% for item in block.items %}<li>{{ item }}</li>{% endfor %}</ol>
      {% elif block.type == "ul" %}
        <ul>{% for item in block.items %}<li>{{ item }}</li>{% endfor %}</ul>
      {% elif block.type == "table" %}
        <table class="data">
          <thead><tr>{% for c in block.items[0] %}<th>{{ c }}</th>{% endfor %}</tr></thead>
          <tbody>
            {% for row in block.items[1:] %}
              <tr>{% for c in row %}<td>{{ c }}</td>{% endfor %}</tr>
            {% endfor %}
          </tbody>
        </table>
      {% elif block.type == "figure" %}
        <figure class="figure">
          <div class="figure-placeholder">[ diagram ]</div>
          <figcaption>{{ block.text }}</figcaption>
        </figure>
      {% endif %}
    {% endfor %}
  {% else %}
    <p class="notice">No content detected.</p>
  {% endif %}
</section>
{% endfor %}