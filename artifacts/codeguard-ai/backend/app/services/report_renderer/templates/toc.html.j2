<section class="page front" id="anchor-toc">
  <h1>Table of Contents</h1>
  <div class="rule"></div>

  <ul class="toc-list">
    <li>
      <span class="toc-title">Acknowledgement</span>
      <span class="toc-dots"></span>
      <a class="toc-page" href="#anchor-ack"></a>
    </li>

    {% for ch in ctx.chapters %}
    <li>
      <span class="toc-title">{{ ch.heading }}</span>
      <span class="toc-dots"></span>
      <a class="toc-page" href="#anchor-chapter-{{ loop.index }}"></a>
    </li>
    {% endfor %}

    <li>
      <span class="toc-title">Appendices</span>
      <span class="toc-dots"></span>
      <a class="toc-page" href="#anchor-appendices"></a>
    </li>
    <li>
      <span class="toc-title">References</span>
      <span class="toc-dots"></span>
      <a class="toc-page" href="#anchor-references"></a>
    </li>
  </ul>
</section>