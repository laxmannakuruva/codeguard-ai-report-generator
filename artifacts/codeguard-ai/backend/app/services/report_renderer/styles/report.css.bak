@page {
  size: A4;
  margin: 15mm;
  border: 1pt solid #000;
}

* { box-sizing: border-box; }

html, body {
  margin: 0;
  padding: 0;
  background: #fff;
  color: #000;
  font-family: "DejaVu Serif", Georgia, 'Times New Roman', serif;
  font-size: 11.5pt;
  line-height: 1.65;
}

.page {
  padding: 8mm;
  page-break-after: always;
}

.page:last-child {
  page-break-after: auto;
}

h1 { font-size: 18pt; line-height: 1.3; margin: 0 0 12pt 0; page-break-after: avoid; }
h2 { font-size: 13pt; line-height: 1.3; margin: 16pt 0 8pt 0; page-break-after: avoid; }
p  { margin: 0 0 10pt 0; text-align: justify; orphans: 4; widows: 4; }

ol, ul { margin: 6pt 0 14pt 0; padding-left: 24pt; }
li     { margin: 0 0 8pt 0; line-height: 1.65; display: list-item; }

.cover { text-align: center; padding-top: 60mm; }
.cover .kicker { font-size: 11pt; letter-spacing: 3pt; text-transform: uppercase; margin-bottom: 22pt; }
.cover .on { font-size: 12pt; letter-spacing: 1.5pt; margin: 8pt 0; }
.cover h1.project-title { font-size: 26pt; line-height: 1.25; margin: 20pt 0 30pt 0; font-weight: 700; }
.cover .by { font-size: 12pt; margin-top: 30pt; }
.cover .student-line { font-size: 13pt; margin: 4pt 0; font-weight: 600; }
.cover .submission { font-style: italic; font-size: 11pt; margin: 30pt auto 0 auto; color: #333; }
.cover .date { font-size: 12pt; margin-top: 30pt; }

.front h1 { text-align: center; text-transform: uppercase; letter-spacing: 1.5pt; margin: 0 0 6pt 0; }
.front .rule { height: 1.2pt; background: #000; margin: 0 auto 22pt auto; width: 30%; }

.chapter .chapter-title { border-bottom: 1.2pt solid #000; padding-bottom: 6pt; margin: 0 0 16pt 0; font-size: 18pt; }

/* ---------- TOC with dot leaders ---------- */

.toc-list { list-style: none; padding: 0; margin: 12pt 0 0 0; }
.toc-list li {
  display: flex;
  align-items: baseline;
  margin: 8pt 0;
}
.toc-list .toc-title { font-weight: 600; flex-shrink: 0; }
.toc-list .toc-dots {
  flex: 1;
  border-bottom: 1pt dotted #333;
  margin: 0 6pt;
  transform: translateY(-4pt);
  min-width: 20pt;
}
.toc-list .toc-page {
  font-weight: 700;
  flex-shrink: 0;
  min-width: 2ch;
  text-align: right;
  text-decoration: none;
  color: #000;
}
.toc-list .toc-page::after {
  content: target-counter(attr(href), page);
}

/* ---------- Data tables ---------- */

table.data { width: 100%; border-collapse: collapse; margin: 12pt 0 18pt 0; font-size: 10.5pt; }
table.data th, table.data td { border: 0.75pt solid #000; padding: 7pt 9pt; text-align: left; vertical-align: top; }
table.data th { background: #f0f0f0; font-weight: 700; }

/* ---------- Figures ---------- */

figure.figure { margin: 16pt auto; text-align: center; page-break-inside: avoid; }
figure.figure img { max-width: 100%; max-height: 240pt; border: 0.75pt solid #000; padding: 4pt; }
figure.figure figcaption { font-size: 9.5pt; font-style: italic; margin-top: 6pt; }

/* ---------- References ---------- */

.references-list { padding-left: 24pt; list-style: decimal; }
.references-list li { margin: 0 0 12pt 0; line-height: 1.6; display: list-item; }

/* ---------- Misc ---------- */

pre.tree {
  font-family: Consolas, monospace;
  font-size: 9.5pt;
  line-height: 1.5;
  background: #fafafa;
  border: 0.75pt solid #333;
  padding: 10pt 12pt;
  white-space: pre-wrap;
  word-break: break-all;
}

.notice { font-style: italic; color: #333; }